<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tao</groupId>
    <artifactId>tao-sandbox</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tao-sandbox-ai-experimental</artifactId>
  <name>tao-sandbox :: ai-experimental</name>
  <description>
    Experimental AI capabilities for the sandbox. First intended use: generate mock payloads from a
    schema and a prompt. Deliberately separate so experiments cannot destabilise the mock service.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Generation needs the parsed contracts and the validator, both of which are stable public API
      of the mock library: SpecRegistry supplies the schema a payload must satisfy, and
      MockValidator is what decides whether the generated one does. Depending on the library is
      the plain answer — see the note in ai/package-info.java, which posed this and now records it.
    -->
    <dependency>
      <groupId>com.tao</groupId>
      <artifactId>tao-sandbox-mock-data</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      A model starter is not declared here on purpose. Which provider to use is a decision for
      when this module does something, and pulling one in now would commit the project to it and
      require credentials to build. `spring-ai-client-chat` gives the provider-neutral API.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>

    <!--
      Identity only — not an Azure OpenAI SDK. The wire format is OpenAI's and is spoken over the
      HTTP client this application already has; what Azure genuinely adds is how a caller proves
      who it is, and that is worth a library rather than a hand-rolled OAuth exchange. It is also
      what makes a service principal locally and a managed identity in Azure the same code path.
    -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
    </dependency>
  </dependencies>
</project>
