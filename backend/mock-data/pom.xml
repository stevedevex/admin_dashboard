<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tao</groupId>
    <artifactId>tao-sandbox</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tao-sandbox-mock-data</artifactId>
  <name>tao-sandbox :: mock-data</name>
  <description>Schema-driven mock service for REST and SOAP contracts. A library, not an
    application: it auto-configures itself into whatever Boot app depends on it.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- OpenAPI ingestion. XML and XSD work uses the JDK, so there is no WSDL library.
         The javax-flavoured swagger-core artifacts are excluded and replaced with the jakarta
         flavour below: the two jars carry identical class names, springdoc (in the app module)
         ships jakarta, and whichever flavour wins the classpath decides whether the other's
         users crash on a missing javax.xml.bind. One flavour, everywhere. -->
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser</artifactId>
      <exclusions>
        <exclusion>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-annotations</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-models</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-core-jakarta</artifactId>
    </dependency>

    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- MockMvc's auto-configuration left spring-boot-starter-test in Boot 4 and now ships here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
